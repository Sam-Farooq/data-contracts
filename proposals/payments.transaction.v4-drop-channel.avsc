{
  "type": "record",
  "name": "Transaction",
  "namespace": "payments",
  "doc": "Candidate: drops channel. Hand authored for this repository as an example of a change the subject policy allows and two consumers do not.",
  "fields": [
    {
      "name": "transaction_id",
      "type": "string"
    },
    {
      "name": "account_id",
      "type": "string"
    },
    {
      "name": "amount_minor",
      "type": "long",
      "doc": "Amount in the currency's minor units. Integer on purpose."
    },
    {
      "name": "currency",
      "type": "string",
      "doc": "ISO 4217 alphabetic code"
    },
    {
      "name": "occurred_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "settled_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null,
      "doc": "Null until the settlement file lands."
    },
    {
      "name": "merchant",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Merchant",
          "fields": [
            {
              "name": "merchant_id",
              "type": "string"
            },
            {
              "name": "category_code",
              "type": [
                "null",
                "string"
              ],
              "default": null
            },
            {
              "name": "country",
              "type": [
                "null",
                "string"
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null,
      "doc": "Replaces the flat mcc field, which v3 drops."
    }
  ]
}
