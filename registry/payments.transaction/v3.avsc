{
  "type": "record",
  "name": "Transaction",
  "namespace": "payments",
  "doc": "Drops mcc in favour of a nested merchant, and gives Channel a fallback.",
  "fields": [
    {"name": "transaction_id", "type": "string"},
    {"name": "account_id", "type": "string"},
    {
      "name": "amount_minor",
      "type": "long",
      "doc": "Amount in the currency's minor units. Integer on purpose."
    },
    {"name": "currency", "type": "string", "doc": "ISO 4217 alphabetic code"},
    {
      "name": "occurred_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"}
    },
    {
      "name": "channel",
      "type": {
        "type": "enum",
        "name": "Channel",
        "symbols": ["CARD", "TRANSFER", "DIRECT_DEBIT"],
        "default": "CARD",
        "doc": "The fallback is what lets a later symbol be added without breaking a reader on this version."
      }
    },
    {
      "name": "settled_at",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Null until the settlement file lands."
    },
    {
      "name": "merchant",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Merchant",
          "fields": [
            {"name": "merchant_id", "type": "string"},
            {"name": "category_code", "type": ["null", "string"], "default": null},
            {"name": "country", "type": ["null", "string"], "default": null}
          ]
        }
      ],
      "default": null,
      "doc": "Replaces the flat mcc field, which v3 drops."
    }
  ]
}
